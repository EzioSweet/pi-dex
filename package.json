{
  "name": "pi-dex",
  "version": "0.1.0",
  "description": "Pi, but with Codex's UI — or at least as far as I can go before forking it.",
  "author": "Maria <maria@kuuro.net>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maria-rcks/pi-dex.git"
  },
  "bugs": {
    "url": "https://github.com/maria-rcks/pi-dex/issues"
  },
  "homepage": "https://github.com/maria-rcks/pi-dex#readme",
  "type": "module",
  "packageManager": "bun@1.3.9",
  "keywords": [
    "pi-package",
    "pi",
    "pi-agent",
    "extension",
    "theme",
    "codex",
    "pidex"
  ],
  "files": [
    "index.ts",
    "src",
    "themes",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "lint": "oxlint .",
    "typecheck": "tsgo --noEmit -p tsconfig.json",
    "check": "bun run lint && bun run typecheck",
    "pack:dry": "bun pm pack --dry-run"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "themes": [
      "./themes"
    ]
  },
  "peerDependencies": {
    "@mariozechner/pi-agent-core": "^0.56.3",
    "@mariozechner/pi-ai": "^0.56.3",
    "@mariozechner/pi-coding-agent": "^0.56.3",
    "@mariozechner/pi-tui": "^0.56.3",
    "@sinclair/typebox": "^0.34.48"
  },
  "devDependencies": {
    "@types/node": "^25.3.5"
  }
}
